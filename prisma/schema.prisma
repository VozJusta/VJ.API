generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Citizen {
  id                 String             @id @default(uuid())
  full_name          String
  cpf                String?            @unique
  cnpj               String?            @unique
  avatar_image       String?
  stripe_customer_id String?            @unique
  phone              String?            @unique
  email              String             @unique
  password           String?
  created_at         DateTime           @default(now())
  session_id         String             @default(uuid())
  cases              Case[]
  caseRequests       CaseRequest[]
  notifications      Notification[]
  report             Report[]
  simulation         Simulation[]
  simulation_report  SimulationReport[]
  subscription       Subscription?
  validationCodes    ValidationCode[]
}

model Lawyer {
  id                 String           @id @default(uuid())
  stripe_customer_id String?          @unique
  full_name          String
  bio                String?
  cpf                String?          @unique
  cnpj               String?            @unique
  avatar_image       String?
  rating             Decimal?         @default(0)
  specialization     Specialization?
  lawyer_status      LawyerStatus     @default(Pending)
  oab_number         String?
  phone              String?          @unique
  email              String           @unique
  password           String?
  created_at         DateTime         @default(now())
  oab_state          OabState?
  session_id         String           @default(uuid())
  cases              Case[]
  caseRequests       CaseRequest[]
  notifications      Notification[]
  report             Report[]
  subscription       Subscription?
  validationCodes    ValidationCode[]
}

model Plan {
  id               String         @id @default(uuid())
  name             String
  stripe_price_id  String         @unique @default(uuid())
  type             PlanType       @default(FREE)
  billing_type     BillingType
  max_interviews   Int
  max_simulation   Int
  has_ia_petitions Boolean        @default(false)
  has_analytics    Boolean        @default(false)
  subscriptions    Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  citizen_id             String?            @unique
  lawyer_id              String?            @unique
  stripe_subscription_id String             @unique @default(uuid())
  subscription_status    SubscriptionStatus
  interviews_used        Int                @default(0)
  simulations_used       Int                @default(0)
  leads_used             Int                @default(0)
  current_period_start   DateTime           @default(now())
  current_period_end     DateTime
  planId                 String
  citizen                Citizen?           @relation(fields: [citizen_id], references: [id])
  lawyer                 Lawyer?            @relation(fields: [lawyer_id], references: [id])
  plan                   Plan               @relation(fields: [planId], references: [id])
}

model Report {
  id                     String         @id @default(uuid())
  transcription          String
  legal_analysis         String
  simplified_explanation String
  category_detected      Specialization
  citizen_id             String
  lawyer_id              String?
  created_at             DateTime       @default(now())
  confidence_score       Float?
  normalized_text        String
  caseId                 String
  ai_versions            AiResponse[]
  ragContexts            RagContext[]
  case                   Case           @relation(fields: [caseId], references: [id])
  citizen                Citizen        @relation(fields: [citizen_id], references: [id])
  lawyer                 Lawyer?        @relation(fields: [lawyer_id], references: [id])
  simulations            Simulation[]
}

model Case {
  id            String         @id @default(uuid())
  citizen_id    String
  lawyer_id     String?
  status        Status         @default(Pending)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  title         String
  citizen       Citizen        @relation(fields: [citizen_id], references: [id])
  lawyer        Lawyer?        @relation(fields: [lawyer_id], references: [id])
  caseRequests  CaseRequest[]
  conversations Conversation[]
  reports       Report[]
}

model CaseRequest {
  id         String   @id @default(uuid())
  case_id    String
  citizen_id String
  lawyer_id  String
  status     Status   @default(Pending)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  case       Case     @relation(fields: [case_id], references: [id])
  citizen    Citizen  @relation(fields: [citizen_id], references: [id])
  lawyer     Lawyer   @relation(fields: [lawyer_id], references: [id])

  @@unique([case_id, lawyer_id])
}

model Conversation {
  id         String    @id @default(uuid())
  case_id    String
  is_closed  Boolean   @default(false)
  created_at DateTime  @default(now())
  case       Case      @relation(fields: [case_id], references: [id])
  messages   Message[]
}

model Message {
  id              String       @id @default(uuid())
  conversation_id String
  role            MessageRole
  content         String
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
}

model AiResponse {
  id          String   @id @default(uuid())
  report_id   String
  model       String
  provider    String
  prompt      String
  response    String
  tokens_used Int?
  latency_ms  Int?
  created_at  DateTime @default(now())
  report      Report   @relation(fields: [report_id], references: [id])
}

model RagContext {
  id         String   @id @default(uuid())
  report_id  String
  source     String
  content    String
  score      Float
  created_at DateTime @default(now())
  report     Report   @relation(fields: [report_id], references: [id])
}

model ValidationCode {
  id         String   @id @default(uuid())
  type       Types
  expired    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  validated  Boolean  @default(false)
  email      String
  code       String
  lawyer_id  String?
  citizen_id String?
  citizen    Citizen? @relation(fields: [citizen_id], references: [id])
  lawyer     Lawyer?  @relation(fields: [lawyer_id], references: [id])
}

model Simulation {
  id                String            @id @default(uuid())
  citizen_id        String
  personality       Personality
  transcription     String?
  score_feedback    String?
  report_id         String?
  duration_secs     Int?
  ended_at          DateTime?
  started_at        DateTime          @default(now())
  status            SimStatus?        @default(Waiting)
  citizen           Citizen           @relation(fields: [citizen_id], references: [id])
  report            Report?           @relation(fields: [report_id], references: [id])
  simulation_report SimulationReport?
  turns             SimulationTurn[]
}

model SimulationTurn {
  id            String     @id @default(uuid())
  simulation_id String
  role          TurnRole
  content       String
  audio_url     String?
  created_at    DateTime   @default(now())
  simulation    Simulation @relation(fields: [simulation_id], references: [id])
}

model SimulationReport {
  id              String      @id @default(uuid())
  created_at      DateTime    @default(now())
  duration_secs   Int?
  full_transcript Json
  metrics_json    Json?
  personality     Personality
  score           Int?
  simulation_id   String      @unique
  strengths       String[]
  user_id         String
  weaknesses      String[]
  simulation      Simulation  @relation(fields: [simulation_id], references: [id])
  user            Citizen     @relation(fields: [user_id], references: [id])
}

model Evidence {
  id          String @id @default(uuid())
  file_url    String
  ocr_content String
  embedding   Json?
  public_id   String @unique
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  body       String
  type       NotificationType
  is_read    Boolean          @default(false)
  metadata   Json?
  citizen_id String?
  lawyer_id  String?
  created_at DateTime         @default(now())
  read_at    DateTime?
  citizen    Citizen?         @relation(fields: [citizen_id], references: [id])
  lawyer     Lawyer?          @relation(fields: [lawyer_id], references: [id])

  @@index([citizen_id, created_at])
  @@index([lawyer_id, created_at])
}

enum Specialization {
  Administrative
  Customs
  Legal_support
  Aviation
  Agrarian
  Environmental
  Arbitration
  Copyright
  Banking_and_financial
  Biotechnology
  Civil
  Commercial
  International_trade
  Competition
  Constitutional
  Consumer
  Commercial_contracts
  Sports
  Water
  Third_sector
  Economic
  Electoral
  Corporate_criminal
  Energy
  Bankruptcy
  Family
  Mergers
  Real_estate
  Import_and_export
  Infrastructure
  International
  Internet_and_ECommerce
  Maritime
  Capital_markets
  Mining
  Financial_operations
  Criminal
  Oil_and_gas
  Social_security
  Project_finance
  Intellectual_property
  Corporate_restructuring
  Regulatory
  Health_and_sanitary
  Insurance
  Labor_union
  Corporate
  Telecommunications
  Labor_and_employment
  Tax
}

enum LawyerStatus {
  Pending
  Verified
  Suspended
  Rejected
}

enum PlanType {
  MEDIUM
  PREMIUM
  FREE
}

enum MessageRole {
  User
  Assistant
}

enum BillingType {
  Monthly
  One_Time
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  unpaid
  inactive
}

enum Status {
  Accepted
  Refused
  Pending
}

enum Types {
  Email
  SMS
}

enum TurnRole {
  User
  Ai
}

enum SimStatus {
  Waiting
  InProgress
  Completed
  TimedOut
}

enum Personality {
  Calm
  Agressive
  Impartial
  Empathetic
  Pragmatic
  Researcher
}

enum OabState {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum NotificationType {
  REQUEST_SENT
  REQUEST_ACCEPTED
  REQUEST_REFUSED
}
